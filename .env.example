# ── Provider 1: football-data.org (European competitions, ranged future fixtures)
# Register at https://www.football-data.org/client/register (free tier).
VITE_FOOTBALL_DATA_API_TOKEN=

# ── Provider 2: API-Football / API-Sports direct free plan (100 req/day).
# Required for Tunisian Ligue 1 and other competitions not on football-data.org's
# free tier (Europa/Conference League, cups, CAF CL, Saudi Pro League...).
# Register at https://www.api-football.com/
VITE_API_FOOTBALL_KEY=

# Both credentials are exposed to the local browser frontend by design.
# LOCAL MVP ONLY — before ANY public deployment both MUST move behind a
# server/serverless proxy.
